# ============================================================
# Convert Pipeline — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env_example .env
#
# The .env file is NOT committed to git.
# ============================================================

# Required: API key for LLM provider (DeepSeek or Qwen DashScope)
FYP_CONVERT_API_KEY=sk-your-api-key-here

# Optional: Provider selection (deepseek or qwen, default: deepseek)
FYP_CONVERT_PROVIDER=deepseek

# Optional: Model override (uses provider default if not set)
# DeepSeek default: deepseek-v4-pro
# Qwen default:    qwen-plus
# FYP_CONVERT_MODEL=deepseek-v4-pro

# Optional: API base URL override (uses provider default if not set)
# FYP_CONVERT_BASE_URL=
