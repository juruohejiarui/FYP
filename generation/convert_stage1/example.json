    "stage1_clinical_brief": {
      "reason_effort": "medium",
      "temperature": 0.15
    },
    "stage1_clinical_brief_repair": {
      "reason_effort": "high",
      "temperature": 0.1
    },
    "stage2_encounter_director": {
      "reason_effort": "high",
      "temperature": 0.65
    },
    "stage2_encounter_director_repair": {
      "reason_effort": "high",
      "temperature": 0.2
    },
    "stage3_spoken_performance_plan": {
      "reason_effort": "high",
      "temperature": 0.75
    },
    "stage3_spoken_performance_plan_repair": {
      "reason_effort": "high",
      "temperature": 0.2
    },
    "stage4_spoken_base": {
      "reason_effort": "high",
      "temperature": 0.1
    },
    "stage4_spoken_base_repair": {
      "reason_effort": "high",
      "temperature": 0.2
    },
    "stage5_disfluency_plan": {
      "reason_effort": "medium",
      "temperature": 0.1
    },
    "stage6_surface_generation": {
      "reason_effort": "high",
      "temperature": 0.3
    },
    "stage6_surface_repair": {
      "reason_effort": "high",
      "temperature": 0.2
    },
    "stage7_clinical_naturalness_judge": {
      "reason_effort": "medium",
      "temperature": 0.15
    }
  }
